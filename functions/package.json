{
  "name": "thakur-bites-functions",
  "version": "1.0.0",
  "description": "Trusted backend engine for Thakur Bites canteen platform",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "test:emulator": "firebase emulators:exec --only firestore 'node --test test/emulator/*.test.js'"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "typescript": "^5.7.0"
  },
  "private": true
}
