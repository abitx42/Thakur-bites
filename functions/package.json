{
  "name": "thakur-bites-functions",
  "version": "1.0.0",
  "description": "Trusted backend engine for Thakur Bites canteen platform",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "pretest": "npm run build",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "test:emulator": "npm --prefix .. run test:rules",
    "test:rules:local": "node --test --test-reporter=spec test/emulator/*.test.js"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "uuid": "^11.1.1"
  },
  "private": true
}
