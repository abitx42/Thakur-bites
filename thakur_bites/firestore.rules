rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isStaff() {
      return isAuthenticated() && request.auth.token.role in ['kitchen', 'pickup', 'manager', 'admin', 'security_admin'];
    }

    function isManagerOrAdmin() {
      return isAuthenticated() && request.auth.token.role in ['manager', 'admin', 'security_admin'];
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role in ['admin', 'security_admin'];
    }

    // ─── Menu Items ─────────────────────────────────────────────
    // Public read for live canteen catalog. Direct writes restricted to Managers/Admins only.
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isManagerOrAdmin();
    }

    // ─── Orders ─────────────────────────────────────────────────
    // Students can ONLY read their own orders. Staff can read orders for operations.
    // DIRECT CLIENT WRITES ARE BLOCKED: All order placement, price calculation,
    // and status transitions must execute through trusted Cloud Functions.
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isStaff()
      );
      allow create, update, delete: if false;
    }

    // ─── Students Profile ───────────────────────────────────────
    // Students can read and update ONLY harmless profile fields (name, phone, department, photoUrl).
    // Security fields (role, isVerified, accountDisabled, uid) are strictly protected.
    match /students/{studentId} {
      allow read: if isOwner(studentId) || isStaff();
      allow create: if isOwner(studentId);
      allow update: if isOwner(studentId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'department', 'year', 'photoUrl', 'updatedAt']);
      allow delete: if false;
    }

    // ─── Student Feedback & Ratings ─────────────────────────────
    match /ratings/{ratingId} {
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow read: if isStaff() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow update, delete: if false;
    }

    // ─── Staff Users (RBAC Records) ─────────────────────────────
    // Staff profiles managed exclusively via admin Cloud Functions.
    match /staffUsers/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // ─── Payments & Financial Records ───────────────────────────
    // Students can read their own receipts. Writes are backend-only.
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isStaff()
      );
      allow write: if false;
    }

    match /financialTransactions/{txnId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /dailyReconciliations/{date} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ─── Immutable Audit Ledgers ────────────────────────────────
    // Client direct writes strictly denied. Append-only via backend.
    match /inventoryLedger/{ledgerId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /orderEvents/{eventId} {
      allow read: if isAuthenticated() && (
        resource.data.actorId == request.auth.uid || isStaff()
      );
      allow write: if false;
    }

    match /securityEvents/{eventId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ─── Internal System Collections ────────────────────────────
    match /counters/{counterId} {
      allow read, write: if false;
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    match /processedGatewayEvents/{eventId} {
      allow read, write: if false;
    }

    match /checkoutRequests/{reqId} {
      allow read, write: if false;
    }
  }
}
