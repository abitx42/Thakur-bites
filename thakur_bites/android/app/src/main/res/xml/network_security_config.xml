<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration: Strictly forbid cleartext traffic and trust ONLY system CAs (neutralizing user-installed proxy CAs) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
