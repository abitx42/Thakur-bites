# Values here are placeholders, never credentials. Do not commit a populated .env.
HOST=127.0.0.1
PORT=8080
# Public assets: npm run build:web stages into dist/site.
PUBLIC_DIR=dist/site
# Backend variables: provision securely in the Functions environment.
# Generate a fresh high-entropy QR secret; NEVER reuse the retired source default.
QR_SIGNING_SECRET=
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ENFORCE_APP_CHECK=true
SIMULATE_PAYMENTS=false
# PUBLIC reCAPTCHA v3 site key: configure js/publicConfig.js and pass this
# variable to npm run build:web. It is not a server secret.
FIREBASE_APP_CHECK_WEB_KEY=
# Optional Antideploy runtime deployment. Inject token through a secret manager,
# not a committed file or shell command literal. Package-only needs neither.
ANTIDEPLOY_APPLICATION_ID=
ANTIDEPLOY_TOKEN=
