rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Granular Role-Based Access Control (RBAC) Functions ─────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getStaffRole() {
      // A role change must also invalidate an old, not-yet-expired ID token.
      return !isAuthenticated() ? null :
        (exists(/databases/$(database)/documents/staffUsers/$(request.auth.uid)) ?
          currentStaffRole(get(/databases/$(database)/documents/staffUsers/$(request.auth.uid)).data) :
          ('role' in request.auth.token ? request.auth.token.role : null));
    }

    function currentStaffRole(staff) {
      return (!('role' in request.auth.token) || request.auth.token.role == staff.role) ? staff.role : null;
    }

    function mumbaiShiftDate() {
      let ist = request.time + duration.value(330, 'm');
      return string(ist.year()) + '-' + (ist.month() < 10 ? '0' : '') + string(ist.month())
        + '-' + (ist.day() < 10 ? '0' : '') + string(ist.day());
    }

    function workstationShiftDeadline(shiftWindow) {
      let localDayStart = (request.time + duration.value(330, 'm')).date() - duration.value(330, 'm');
      return localDayStart + (shiftWindow == 'MORNING' ? duration.value(930, 'm') :
        shiftWindow == 'AFTERNOON' ? duration.value(1320, 'm') : duration.value(86399999, 'ms'));
    }

    function hasActiveWorkstationSession() {
      // Match shift_pins.ts: every ephemeral identity needs the current login
      // generation, PIN issuance and enrolled hardware, not just an ACTIVE flag.
      let uid = request.auth.uid;
      let token = request.auth.token;
      let shiftIdentity = uid.matches('^staff_.*');
      return (!shiftIdentity && !('isWorkstationSession' in token && token.isWorkstationSession == true))
        || (
          shiftIdentity && 'isWorkstationSession' in token && token.isWorkstationSession == true
          && token.role in ['kitchen', 'pickup', 'cashier']
          && token.deviceId is string && token.deviceId.matches('^[A-Za-z0-9_-]{4,100}$')
          && token.shiftDate is string && token.shiftDate == mumbaiShiftDate()
          && token.shiftWindow in ['MORNING', 'AFTERNOON', 'FULL_DAY']
          && token.pinId is string
          && token.pinId.matches('^(kitchen|pickup|cashier)_[0-9]{4}-[0-9]{2}-[0-9]{2}_(MORNING|AFTERNOON|FULL_DAY)$')
          && token.sessionGeneration is string && token.sessionGeneration.matches('^[a-f0-9]{32}$')
          && validWorkstationSession(uid, token)
        );
    }

    function validWorkstationSession(uid, token) {
      // Bind resource reads once. Passing get(...).data as an argument causes
      // repeated expression evaluation when a large validation body is inlined.
      // A missing document/field fails closed without a second exists() read.
      let session = get(/databases/$(database)/documents/workstationSessions/$(uid)).data;
      return session.sessionId == uid
        && session.status == 'ACTIVE'
        && session.sessionGeneration == token.sessionGeneration
        && session.createdAt is timestamp && session.createdAt.toMillis() > 0 && session.createdAt <= request.time
        && session.expiresAt is timestamp && session.expiresAt > request.time
        && session.expiresAt > session.createdAt && session.expiresAt <= session.createdAt + duration.value(8, 'h')
        && session.role == token.role
        && session.deviceId == token.deviceId
        && session.deviceHash is string && session.deviceHash.matches('^[a-f0-9]{16}$')
        && hashing.sha256('DEVICE_' + session.deviceId).toHexString().lower().matches(session.deviceHash + '[a-f0-9]{48}')
        && session.shiftDate == token.shiftDate
        && session.shiftWindow == token.shiftWindow
        && session.pinId == token.pinId
        && session.pinGeneration is string && session.pinGeneration.matches('^[a-f0-9]{64}$')
        && validWorkstationOrigin(session);
    }

    function validWorkstationOrigin(session) {
      let pin = get(/databases/$(database)/documents/shiftPins/$(session.pinId)).data;
      let hardware = get(/databases/$(database)/documents/registeredWorkstations/$(session.deviceId)).data;
      return validWorkstationPin(pin, session) && validRegisteredWorkstation(hardware, session);
    }

    function validWorkstationPin(pin, session) {
      return pin.pinId == session.pinId && pin.status == 'ACTIVE'
        && pin.role == session.role
        && pin.shiftDate == session.shiftDate
        && pin.shiftWindow == session.shiftWindow
        && pin.pinId == pin.role + '_' + pin.shiftDate + '_' + pin.shiftWindow
        && pin.createdAt is timestamp && pin.createdAt.toMillis() > 0 && pin.createdAt <= session.createdAt
        && pin.expiresAt is timestamp && pin.expiresAt > request.time
        && pin.expiresAt > pin.createdAt && pin.expiresAt <= workstationShiftDeadline(pin.shiftWindow)
        && session.expiresAt <= pin.expiresAt
        && pin.pinHash is string && pin.pinHash.matches('^[a-fA-F0-9]{64}$')
        && pin.salt is string && pin.salt.matches('^[a-fA-F0-9]{32}$')
        // Same SHA-256(JSON.stringify([pinId, pinHash, salt, createdAtMs]))
        // fingerprint as activePinState in shift_pins.ts. Validated fields have
        // no JSON-escape characters; regenerated hashes/salts cannot match it.
        && session.pinGeneration == hashing.sha256('["' + pin.pinId + '","' + pin.pinHash + '","'
          + pin.salt + '",' + string(pin.createdAt.toMillis()) + ']').toHexString().lower()
        && pin.boundDevices is list
        && session.deviceId in pin.boundDevices
        && pin.maxDevices is int && pin.maxDevices > 0 && pin.maxDevices <= (pin.role == 'pickup' ? 3 : 2)
        && pin.boundDevices.size() <= pin.maxDevices;
    }

    function validRegisteredWorkstation(workstation, session) {
      return workstation.workstationId == session.deviceId && workstation.status == 'ACTIVE'
        && workstation.stationType == session.role
        && workstation.tokenHash is string && workstation.tokenHash.matches('^[a-fA-F0-9]{64}$')
        && session.workstationTokenHash == workstation.tokenHash;
    }

    function hasStaffRole(roles) {
      return isAuthenticated() && getStaffRole() in roles && hasActiveWorkstationSession();
    }

    function isAdmin() {
      return hasStaffRole(['admin', 'manager']);
    }

    function isDeveloper() {
      return hasStaffRole(['developer', 'security_admin', 'system']);
    }

    function isSecurityAdmin() {
      return isDeveloper();
    }

    function hasAdministrativeAccess() {
      return hasStaffRole(['manager', 'admin', 'developer', 'security_admin', 'system']);
    }

    function isManagerOrAdmin() {
      return hasAdministrativeAccess();
    }

    function isOperationalStaff() {
      return hasStaffRole(['kitchen', 'pickup', 'cashier', 'manager', 'admin', 'developer', 'security_admin', 'system']);
    }

    // ─── Menu Items (Server Authority Architecture) ───────────────
    // Prices, availability and stock are validated/audited by Cloud Functions.
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Categories & Subcategories Taxonomy ──────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;

      match /subcategories/{subId} {
        allow read: if true;
        allow write: if false;
      }
    }


    // ─── Orders (Server Authority) ────────────────────────────────
    // Customers retain own reads and canonical staff retain operational reads.
    // Every mutation requires the backend's state, payment and inventory checks.
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isOperationalStaff()
      );

      allow write: if false;
    }

    // ─── Cryptographic Order Secrets (Isolated from Client/Staff Reads) ──
    match /orderSecrets/{orderId} {
      allow read, write: if false; // Backend Cloud Functions ONLY
    }

    // ─── Students Profile ───────────────────────────────────────
    // Profile creation is restricted strictly to backend Cloud Functions (provisionUserProfile).
    // Students can update ONLY validated profile fields (name, phone, department, year, photoUrl, preferences).
    match /students/{studentId} {
      allow read: if isOwner(studentId) || isManagerOrAdmin();
      allow create: if false; // Backend Cloud Function ONLY
      allow update: if isOwner(studentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'department', 'year', 'photoUrl', 'preferences', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && (!('department' in request.resource.data) || (request.resource.data.department is string && request.resource.data.department.size() <= 50))
        && (!('year' in request.resource.data) || (request.resource.data.year is string && request.resource.data.year in ['FE', 'SE', 'TE', 'BE', 'ME', 'PHD', 'FACULTY', 'STAFF', 'OTHER']));
      allow delete: if false;
    }

    // ─── Student Feedback & Verified Ratings ─────────────────────
    // Public redacted ratings (no student or order identifiers)
    match /ratingsPublic/{ratingId} {
      allow read: if true;
      allow write: if false;
    }

    // Private audit ratings (backend verified)
    match /ratingsPrivate/{ratingId} {
      allow read: if isManagerOrAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    // Legacy unredacted ratings collection (Locked down)
    match /ratings/{ratingId} {
      allow read, write: if false;
    }

    // ─── Staff Users (RBAC Records) ─────────────────────────────
    // Role assignment must synchronize claims, session revocation and audit logs.
    match /staffUsers/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isManagerOrAdmin());
      allow write: if false;
    }

    // ─── Payments & Financial Records (Least-Privilege Isolation) ─
    // Students can read their own receipts. Cashiers/Kitchen CANNOT browse payment ledger docs.
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isAdmin() || isSecurityAdmin()
      );
      allow write: if false;
    }

    match /financialTransactions/{txnId} {
      allow read: if isManagerOrAdmin();
      allow write: if false;
    }

    match /dailyReconciliations/{date} {
      allow read: if isManagerOrAdmin();
      allow write: if false;
    }

    // ─── Inventory Reservations & Audit Ledgers ─────────────────
    match /inventoryReservations/{resId} {
      allow read: if isManagerOrAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    match /inventoryLedger/{ledgerId} {
      allow read: if isManagerOrAdmin();
      allow write: if false;
    }

    match /orderEvents/{eventId} {
      allow read: if isAuthenticated() && (
        resource.data.actorId == request.auth.uid || isManagerOrAdmin()
      );
      allow write: if false;
    }

    match /securityEvents/{eventId} {
      allow read: if isSecurityAdmin() || isAdmin();
      allow write: if false;
    }

    // ─── Internal System Tables ─────────────────────────────────
    match /counters/dailyTokenCounter {
      allow read: if isAuthenticated();
      allow write: if false; // Token allocation is part of server checkout.
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    match /processedGatewayEvents/{eventId} {
      allow read, write: if false;
    }

    match /checkoutRequests/{reqId} {
      allow read, write: if false;
    }

    // ─── Privileged Sessions & MFA (Zero-Trust Platform 2.0) ────
    match /privilegedSessions/{sessionId} {
      allow read, write: if false; // Cloud Functions only
    }

    match /mfaEnrollments/{userId} {
      allow read, write: if false; // Cloud Functions only (TB-VULN-07)
    }

    // ─── Registered Workstations & Hardware Binding ─────────────
    match /registeredWorkstations/{workstationId} {
      allow read: if isManagerOrAdmin();
      allow write: if false;
    }

    match /workstationInvites/{inviteId} {
      allow read, write: if false; // Cloud Functions only
    }

    // ─── Global System Config & Operational Kill Switch ─────────
    // Private System Configuration (Preserves internal staff UID and private incident reasons)
    match /systemConfig/{configId} {
      allow read: if isOperationalStaff();
      allow write: if false; // Cloud Functions only (setSystemOperationalMode)
    }

    // Public Sanitized Operational Status (Zero PII or internal note leakage)
    match /publicSystemStatus/{statusId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only (setSystemOperationalMode)
    }

    // Public Application Version & Update Policy (Read-only to clients)
    match /appConfig/{configId=**} {
      allow read: if true;
      allow write: if false; // Cloud Functions only
    }

    // ─── Universal Users (Platform 2.0) ──────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isManagerOrAdmin();
      allow create: if false;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'rollNo', 'department', 'year', 'photoURL', 'preferences', 'updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 100
        && (!('rollNo' in request.resource.data) || (request.resource.data.rollNo is string && request.resource.data.rollNo.size() <= 30))
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 15))
        && (!('department' in request.resource.data) || (request.resource.data.department is string && request.resource.data.department.size() <= 50))
        && (!('year' in request.resource.data) || (request.resource.data.year is string && request.resource.data.year.size() <= 10))
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500 && (request.resource.data.photoURL.matches('^https://.*') || request.resource.data.photoURL == '')))
        && (!('preferences' in request.resource.data) || (request.resource.data.preferences is map));
      allow delete: if false;

      // User Order Notifications (Read-only to owner, writes strictly Admin SDK / Cloud Functions)
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow write: if false; // Server Admin SDK only
      }
    }

    // ─── User Preferences ────────────────────────────────────────
    match /userPreferences/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['notifications', 'dietary', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    // ─── User Favourites ─────────────────────────────────────────
    match /userFavourites/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50;
      allow delete: if isOwner(userId);
    }

    // ─── Verification Applications ───────────────────────────────
    match /verificationApplications/{appId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isManagerOrAdmin()
      );
      allow write: if false;
    }


    // ─── Priority Configuration ──────────────────────────────────
    match /priorityConfig/{configId} {
      allow read: if true; // Public — clients need to know priority rules
      allow write: if false; // Backend Cloud Function ONLY
    }

    // ─── Faculty Priority Locks (Atomic Concurrency Enforcer) ─────
    match /facultyPriorityLocks/{userId} {
      allow read, write: if false; // Backend Cloud Function ONLY
    }

    // ─── Feature Flags ───────────────────────────────────────────
    match /featureFlags/{flagId} {
      allow read: if true;
      allow write: if false; // Backend Cloud Function ONLY
    }

    // ─── Workstation Shift PINs ───────────────────────────────────
    match /shiftPins/{pinId} {
      allow read: if isManagerOrAdmin();
      allow write: if false;
    }

    // ─── Step-Up Emergency Sessions ──────────────────────────────
    match /stepUpSessions/{sessionId} {
      allow read, write: if false; // Backend Cloud Function ONLY
    }

    // ─── Refund Reservations (Atomic Race-Condition Lock) ─────────────────
    // Written atomically before gateway call to prevent double-refund races.
    // Managers/Admins can inspect for reconciliation. Only backend writes.
    match /refundReservations/{reservationId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Backend Cloud Function ONLY
    }

    // ─── Orphaned Payments Ledger ────────────────────────────────
    match /orphanedPayments/{orphanId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Backend Cloud Function ONLY
    }

    // ─── TV Ephemeral Public Projection (Single Document Isolation) ─
    match /publicLiveQueue/current {
      allow read: if true;
      allow write: if false;
    }

    match /publicLiveQueue/{otherDoc} {
      allow read, write: if false;
    }

    // ─── Daily Menu Board & Canteen Specials ──────────────────────
    // Display/bread-choice configuration is the sole staff-written board API.
    // It cannot be used to create arbitrary config, price or stock records.
    function validBoardText(data, field, maximum) {
      let value = data.get(field, '');
      return value is string && value.size() <= maximum;
    }

    function validDailyBoard() {
      let data = request.resource.data;
      let author = data.get('updatedBy', request.auth.uid);
      // Missing optional fields keep their old meaning. Using get() defaults
      // avoids repeated presence tests and request.resource traversals while
      // retaining every type/length/author check for fields actually supplied.
      return data.keys().hasOnly([
          'date', 'dayOfWeek', 'sabji1', 'sabji2', 'dalOfTheDay', 'sweetOfTheDay',
          'riceType', 'canteenSpecial', 'specialBadge', 'rotiAvailable', 'puriAvailable',
          'announcement', 'isRushHour', 'updatedAt', 'updatedBy'
        ])
        && validBoardText(data, 'date', 10) && validBoardText(data, 'dayOfWeek', 10)
        && validBoardText(data, 'sabji1', 200) && validBoardText(data, 'sabji2', 200)
        && validBoardText(data, 'dalOfTheDay', 200) && validBoardText(data, 'sweetOfTheDay', 200)
        && validBoardText(data, 'riceType', 200) && validBoardText(data, 'canteenSpecial', 200)
        && validBoardText(data, 'specialBadge', 100) && validBoardText(data, 'announcement', 1000)
        && data.get('rotiAvailable', false) is bool
        && data.get('puriAvailable', false) is bool
        && data.get('isRushHour', false) is bool
        && data.get('updatedAt', request.time) is timestamp
        && (author == request.auth.uid
          || (resource != null && 'updatedBy' in resource.data && author == resource.data.updatedBy));
    }

    match /canteenConfig/{configId} {
      allow read: if true;
      allow create, update: if configId == 'dailyMenuBoard' && isOperationalStaff() && validDailyBoard();
      allow delete: if false; // Deletion strictly forbidden to prevent checkout outages
    }

    match /dailyBoard/{docId} {
      allow read: if true;
      allow create, update: if docId == 'today' && isOperationalStaff() && validDailyBoard();
      allow delete: if false; // Deletion strictly forbidden to prevent kitchen outages
    }

    // ─── Authoritative Claims (Isolated Server State) ────────────
    match /authoritativeClaims/{uid} {
      allow read, write: if false; // Server Admin SDK only
    }

    // ─── Integrity Anomalies (Server Admin SDK Only) ──────────────
    match /integrityAnomalies/{anomalyId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Server Admin SDK Only (Client create/update/delete strictly denied)
    }

    // ─── Recovery Approval Requests (Server Admin SDK Only) ─────────
    match /recoveryApprovalRequests/{requestId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Server Admin SDK Only — created/approved by Cloud Functions
    }

    // ─── Staff Notifications (Server Admin SDK Only) ──────────────
    // TB-16: Explicit rule rather than relying on default-deny catch-all.
    // Staff receive notifications via callable Cloud Functions, not direct Firestore listeners.
    match /staffNotifications/{notificationId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Server Admin SDK Only
    }

    // ─── Disaster Recovery & Repair Audit Trail (Server Admin SDK Only) ───
    match /disasterRecoveryLogs/{logId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Server Admin SDK Only (Client create/update/delete strictly denied)
    }

    // ─── Production Incidents & Postmortems (Server Admin SDK Only) ────────
    match /incidents/{incidentId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Server Admin SDK Only
    }

    // ─── Automated Disaster Drill Reports (Server Admin SDK Only) ──────────
    match /disasterDrillReports/{drillId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Server Admin SDK Only
    }

    // ─── Banned Devices Blacklist (Server Admin SDK Only) ────────
    match /bannedDevices/{deviceId} {
      allow read, write: if false; // Cloud Functions only
    }

    // ─── Decoy Honeypot Collections (Adversarial AI & Attacker Traps) ────
    match /adminDebugOverrides/{docId} {
      allow read, write: if false; // Honeypot trap: Any client access strictly denied
    }

    match /canteenDevBackdoor/{docId} {
      allow read, write: if false; // Honeypot trap: Any client access strictly denied
    }

    match /honeyTokens/{tokenId} {
      allow read, write: if false; // Honeypot trap: Any client access strictly denied
    }

    // ─── Default Deny ────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
