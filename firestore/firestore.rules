rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Granular Role-Based Access Control (RBAC) Functions ─────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getStaffRole() {
      return ('role' in request.auth.token) ? request.auth.token.role :
        (exists(/databases/$(database)/documents/staffUsers/$(request.auth.uid)) ?
          get(/databases/$(database)/documents/staffUsers/$(request.auth.uid)).data.role : null);
    }

    function isKitchen() {
      return isAuthenticated() && (
        ('role' in request.auth.token && (request.auth.token.role == 'kitchen' || request.auth.token.role == 'kitchen_staff')) ||
        (getStaffRole() == 'kitchen' || getStaffRole() == 'kitchen_staff')
      );
    }

    function isPickup() {
      return isAuthenticated() && (
        ('role' in request.auth.token && (request.auth.token.role == 'pickup' || request.auth.token.role == 'pickup_staff')) ||
        (getStaffRole() == 'pickup' || getStaffRole() == 'pickup_staff')
      );
    }

    function isCashier() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'cashier') ||
        (getStaffRole() == 'cashier')
      );
    }

    function isManager() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'manager') ||
        (getStaffRole() == 'manager')
      );
    }

    function isAdmin() {
      // SECURITY: Email-regex checks removed — use exact allowlist + domain suffix only.
      // .*admin.* regex was overly broad (e.g., "notadmin@gmail.com" would match).
      return isAuthenticated() && (
        ('role' in request.auth.token && (request.auth.token.role == 'admin' || request.auth.token.role == 'manager')) ||
        (getStaffRole() == 'admin' || getStaffRole() == 'manager') ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'moreaboutastram@gmail.com' ||
          request.auth.token.email == 'adi@tcetmumbai.in' ||
          request.auth.token.email == '1032251174@tcetmumbai.in' ||
          request.auth.token.email == 'adityadjsb@gmail.com' ||
          request.auth.token.email.matches('^[a-zA-Z0-9._%+\\-]+@(tcetmumbai\\.in|thakureducation\\.org)$')
        )) ||
        ('isWorkstationSession' in request.auth.token && request.auth.token.isWorkstationSession == true)
      );
    }

    function isDeveloper() {
      return isAuthenticated() && (
        ('role' in request.auth.token && (request.auth.token.role == 'developer' || request.auth.token.role == 'security_admin')) ||
        (getStaffRole() == 'developer' || getStaffRole() == 'security_admin') ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'moreaboutastram@gmail.com' ||
          request.auth.token.email == 'adi@tcetmumbai.in' ||
          request.auth.token.email == 'adityadjsb@gmail.com' ||
          request.auth.token.email == '1032251174@tcetmumbai.in'
        ))
      );
    }

    function isSecurityAdmin() {
      return isDeveloper();
    }

    function hasAdministrativeAccess() {
      // SECURITY: Removed .*admin.* and .*staff.* open-ended regex patterns.
      // Administrative access now requires exact email allowlist or institutional domain suffix.
      return isAdmin() || isDeveloper() || isManager() ||
        (isAuthenticated() && request.auth.token.email != null &&
          request.auth.token.email.matches('^[a-zA-Z0-9._%+\\-]+@(tcetmumbai\\.in|thakureducation\\.org)$')
        );
    }

    function isManagerOrAdmin() {
      return hasAdministrativeAccess();
    }

    function isOperationalStaff() {
      return isKitchen() || isPickup() || isCashier() || hasAdministrativeAccess();
    }

    // ─── Menu Items (Server Authority Architecture) ───────────────
    // Public read for live canteen catalog. Modifications restricted to Managers/Admins or audited Cloud Functions.
    match /menuItems/{itemId} {
      allow read: if true;
      allow create, update: if (isOperationalStaff() || isManagerOrAdmin())
        && (!('price' in request.resource.data) || (request.resource.data.price is number && request.resource.data.price > 0 && request.resource.data.price <= 10000))
        && (!('stockOnHand' in request.resource.data) || (request.resource.data.stockOnHand is number && request.resource.data.stockOnHand >= 0))
        && (!('reservedStock' in request.resource.data) || (request.resource.data.reservedStock is number && request.resource.data.reservedStock >= 0));
      allow delete: if isManagerOrAdmin();
      // SECURITY: Removed student stock-decrement direct write rule (TB-VULN-STOCK-DOS).
      // Any authenticated student could set isOrderable=false on all menu items causing a canteen-wide
      // denial-of-service. Stock/availability changes are server-authority only via Cloud Functions.
    }

    // ─── Categories & Subcategories Taxonomy ──────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isOperationalStaff() || isManagerOrAdmin();

      match /subcategories/{subId} {
        allow read: if true;
        allow write: if isOperationalStaff() || isManagerOrAdmin();
      }
    }


    // ─── Orders (Least-Privilege Isolation & Operational Resilience) ──
    // Students read their own orders. Staff read station-filtered / operational orders.
    // Order mutations support Cloud Functions as primary and direct authenticated operations
    // for operational continuity (Spark plan / network degraded mode).
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isOperationalStaff()
      );

      // Order creation: Authenticated students for their own order (Spark plan resilience) or Operational Staff (counter POS)
      allow create: if isAuthenticated() && (
        (isOperationalStaff() && request.resource.data.totalAmount is number && request.resource.data.totalAmount >= 0 && request.resource.data.items is list && request.resource.data.items.size() > 0)
        ||
        (
          request.resource.data.studentId == request.auth.uid
          && request.resource.data.totalAmount is number
          && request.resource.data.totalAmount >= 0
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 30
          // Security Invariant: Students cannot create orders marked already 'paid' or 'captured'
          && request.resource.data.paymentStatus in ['pending', 'unpaid']
          // Security Invariant: Students cannot create orders in kitchen/pickup fulfillment states
          && request.resource.data.status in ['payment_pending', 'confirmed', 'placed']
        )
      );

      // Order mutations:
      // 1. Operational staff can advance order states, unlock orders, and manage cash flow (terminal states locked)
      // 2. Students can cancel their own placed/pending orders, or confirm payment status (fields locked against tampering)
      allow update: if isAuthenticated() && (
        (
          isOperationalStaff() &&
          // Invariant: Terminal orders (collected, cancelled) are immutable unless Manager/Admin
          (!(resource.data.status in ['collected', 'cancelled']) || isManagerOrAdmin())
        )
        ||
        (
          resource.data.studentId == request.auth.uid
          && !(resource.data.status in ['collected', 'cancelled'])
          // Field tampering lock: Students CANNOT alter total, items, student ID, token, or pin code
          && request.resource.data.totalAmount == resource.data.totalAmount
          && request.resource.data.items == resource.data.items
          && request.resource.data.studentId == resource.data.studentId
          && (!('tokenNumber' in resource.data) || request.resource.data.tokenNumber == resource.data.tokenNumber)
          && (!('pinCode' in resource.data) || request.resource.data.pinCode == resource.data.pinCode)
          && (
            // Cancellation before kitchen confirmation
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelReason', 'updatedAt'])
              && request.resource.data.status == 'cancelled'
              && resource.data.status in ['placed', 'payment_pending']
            )
            // CRITICAL SECURITY FIX (TB-VULN-FREE-ORDER): Removed student self-payment-confirmation rule.
            // A student could previously call update({paymentStatus: 'paid'}) from the client SDK,
            // bypassing the gateway entirely and receiving free orders.
            // Payment status transitions are NOW strictly server-side only (Cloud Functions webhook handler).
          )
        )
      );

      allow delete: if false;
    }

    // ─── Cryptographic Order Secrets (Isolated from Client/Staff Reads) ──
    match /orderSecrets/{orderId} {
      allow read, write: if false; // Backend Cloud Functions ONLY
    }

    // ─── Students Profile ───────────────────────────────────────
    // Profile creation is restricted strictly to backend Cloud Functions (provisionUserProfile).
    // Students can update ONLY validated profile fields (name, phone, department, year, photoUrl, preferences).
    match /students/{studentId} {
      allow read: if isOwner(studentId) || isManagerOrAdmin();
      allow create: if false; // Backend Cloud Function ONLY
      allow update: if isOwner(studentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'department', 'year', 'photoUrl', 'preferences', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && (!('department' in request.resource.data) || (request.resource.data.department is string && request.resource.data.department.size() <= 50))
        && (!('year' in request.resource.data) || (request.resource.data.year is string && request.resource.data.year in ['FE', 'SE', 'TE', 'BE', 'ME', 'PHD', 'FACULTY', 'STAFF', 'OTHER']));
      allow delete: if false;
    }

    // ─── Student Feedback & Verified Ratings ─────────────────────
    // Public redacted ratings (no student or order identifiers)
    match /ratingsPublic/{ratingId} {
      allow read: if true;
      allow write: if false;
    }

    // Private audit ratings (backend verified)
    match /ratingsPrivate/{ratingId} {
      allow read: if isManagerOrAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    // Legacy unredacted ratings collection (Locked down)
    match /ratings/{ratingId} {
      allow read, write: if false;
    }

    // ─── Staff Users (RBAC Records) ─────────────────────────────
    // Staff profiles managed via admin portal or Cloud Functions.
    match /staffUsers/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isManagerOrAdmin());
      allow write: if isManagerOrAdmin();
    }

    // ─── Payments & Financial Records (Least-Privilege Isolation) ─
    // Students can read their own receipts. Cashiers/Kitchen CANNOT browse payment ledger docs.
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isAdmin() || isSecurityAdmin()
      );
      allow write: if false;
    }

    match /financialTransactions/{txnId} {
      allow read: if isManagerOrAdmin();
      allow write: if false;
    }

    match /dailyReconciliations/{date} {
      allow read: if isManagerOrAdmin();
      allow write: if false;
    }

    // ─── Inventory Reservations & Audit Ledgers ─────────────────
    match /inventoryReservations/{resId} {
      allow read: if isManagerOrAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    match /inventoryLedger/{ledgerId} {
      allow read: if isManagerOrAdmin();
      allow write: if false;
    }

    match /orderEvents/{eventId} {
      allow read: if isAuthenticated() && (
        resource.data.actorId == request.auth.uid || isManagerOrAdmin()
      );
      allow write: if false;
    }

    match /securityEvents/{eventId} {
      allow read: if isSecurityAdmin() || isAdmin();
      allow write: if false;
    }

    // ─── Internal System Tables ─────────────────────────────────
    match /counters/dailyTokenCounter {
      // SECURITY FIX (TB-VULN-TOKEN-HIJACK): Write restricted to operational staff only.
      // Previously any authenticated student could set lastToken 100-1000, causing token collisions.
      allow read: if isAuthenticated();
      allow write: if isOperationalStaff()
        && request.resource.data.lastToken is number
        && request.resource.data.lastToken >= 100
        && request.resource.data.lastToken <= 1000
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    match /processedGatewayEvents/{eventId} {
      allow read, write: if false;
    }

    match /checkoutRequests/{reqId} {
      allow read, write: if false;
    }

    // ─── Privileged Sessions & MFA (Zero-Trust Platform 2.0) ────
    match /privilegedSessions/{sessionId} {
      allow read, write: if false; // Cloud Functions only
    }

    match /mfaEnrollments/{userId} {
      allow read, write: if false; // Cloud Functions only (TB-VULN-07)
    }

    // ─── Registered Workstations & Hardware Binding ─────────────
    match /registeredWorkstations/{workstationId} {
      allow read: if isManagerOrAdmin();
      allow write: if isManagerOrAdmin();
    }

    match /workstationInvites/{inviteId} {
      allow read, write: if false; // Cloud Functions only
    }

    // ─── Global System Config & Operational Kill Switch ─────────
    // Private System Configuration (Preserves internal staff UID and private incident reasons)
    match /systemConfig/{configId} {
      allow read: if isOperationalStaff();
      allow write: if false; // Cloud Functions only (setSystemOperationalMode)
    }

    // Public Sanitized Operational Status (Zero PII or internal note leakage)
    match /publicSystemStatus/{statusId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only (setSystemOperationalMode)
    }

    // Public Application Version & Update Policy (Read-only to clients)
    match /appConfig/{configId=**} {
      allow read: if true;
      allow write: if false; // Cloud Functions only
    }

    // ─── Universal Users (Platform 2.0) ──────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isManagerOrAdmin();
      allow create: if isManagerOrAdmin() || (isOwner(userId)
        && request.resource.data.priorityLevel == 0
        && request.resource.data.isVerified == false
        && (!('role' in request.resource.data))
        && (!('accountType' in request.resource.data) || request.resource.data.accountType == 'STUDENT'));
      allow update: if isManagerOrAdmin() || (
        isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'rollNo', 'department', 'year', 'photoURL', 'preferences', 'updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 100
        && (!('rollNo' in request.resource.data) || (request.resource.data.rollNo is string && request.resource.data.rollNo.size() <= 30))
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 15))
        && (!('department' in request.resource.data) || (request.resource.data.department is string && request.resource.data.department.size() <= 50))
        && (!('year' in request.resource.data) || (request.resource.data.year is string && request.resource.data.year.size() <= 10))
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500 && (request.resource.data.photoURL.matches('^https://.*') || request.resource.data.photoURL == '')))
        && (!('preferences' in request.resource.data) || (request.resource.data.preferences is map))
      );
      allow delete: if isManagerOrAdmin();

      // User Order Notifications (Read-only to owner, writes strictly Admin SDK / Cloud Functions)
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow write: if false; // Server Admin SDK only
      }
    }

    // ─── User Preferences ────────────────────────────────────────
    match /userPreferences/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['notifications', 'dietary', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    // ─── User Favourites ─────────────────────────────────────────
    match /userFavourites/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50;
      allow delete: if isOwner(userId);
    }

    // ─── Verification Applications ───────────────────────────────
    match /verificationApplications/{appId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isManagerOrAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isManagerOrAdmin();
    }


    // ─── Priority Configuration ──────────────────────────────────
    match /priorityConfig/{configId} {
      allow read: if true; // Public — clients need to know priority rules
      allow write: if false; // Backend Cloud Function ONLY
    }

    // ─── Faculty Priority Locks (Atomic Concurrency Enforcer) ─────
    match /facultyPriorityLocks/{userId} {
      allow read, write: if false; // Backend Cloud Function ONLY
    }

    // ─── Feature Flags ───────────────────────────────────────────
    match /featureFlags/{flagId} {
      allow read: if true;
      allow write: if false; // Backend Cloud Function ONLY
    }

    // ─── Workstation Shift PINs ───────────────────────────────────
    match /shiftPins/{pinId} {
      allow read: if isManagerOrAdmin();
      allow write: if isManagerOrAdmin();
    }

    // ─── Step-Up Emergency Sessions ──────────────────────────────
    match /stepUpSessions/{sessionId} {
      allow read, write: if false; // Backend Cloud Function ONLY
    }

    // ─── Refund Reservations (Atomic Race-Condition Lock) ─────────────────
    // Written atomically before gateway call to prevent double-refund races.
    // Managers/Admins can inspect for reconciliation. Only backend writes.
    match /refundReservations/{reservationId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Backend Cloud Function ONLY
    }

    // ─── Orphaned Payments Ledger ────────────────────────────────
    match /orphanedPayments/{orphanId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Backend Cloud Function ONLY
    }

    // ─── TV Ephemeral Public Projection (Single Document Isolation) ─
    match /publicLiveQueue/current {
      allow read: if true;
      allow write: if isOperationalStaff();
    }

    match /publicLiveQueue/{otherDoc} {
      allow read, write: if false;
    }

    // ─── Daily Menu Board & Canteen Specials ──────────────────────
    match /canteenConfig/{configId} {
      allow read: if true;
      allow create, update: if isOperationalStaff();
      allow delete: if false; // Deletion strictly forbidden to prevent checkout outages
    }

    match /dailyBoard/{docId} {
      allow read: if true;
      allow create, update: if isOperationalStaff();
      allow delete: if false; // Deletion strictly forbidden to prevent kitchen outages
    }

    // ─── Authoritative Claims (Isolated Server State) ────────────
    match /authoritativeClaims/{uid} {
      allow read, write: if false; // Server Admin SDK only
    }

    // ─── Integrity Anomalies (Server Admin SDK Only) ──────────────
    match /integrityAnomalies/{anomalyId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Server Admin SDK Only (Client create/update/delete strictly denied)
    }

    // ─── Recovery Approval Requests (Server Admin SDK Only) ─────────
    match /recoveryApprovalRequests/{requestId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Server Admin SDK Only — created/approved by Cloud Functions
    }

    // ─── Staff Notifications (Server Admin SDK Only) ──────────────
    // TB-16: Explicit rule rather than relying on default-deny catch-all.
    // Staff receive notifications via callable Cloud Functions, not direct Firestore listeners.
    match /staffNotifications/{notificationId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Server Admin SDK Only
    }

    // ─── Disaster Recovery & Repair Audit Trail (Server Admin SDK Only) ───
    match /disasterRecoveryLogs/{logId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Server Admin SDK Only (Client create/update/delete strictly denied)
    }

    // ─── Production Incidents & Postmortems (Server Admin SDK Only) ────────
    match /incidents/{incidentId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Server Admin SDK Only
    }

    // ─── Automated Disaster Drill Reports (Server Admin SDK Only) ──────────
    match /disasterDrillReports/{drillId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Server Admin SDK Only
    }

    // ─── Banned Devices Blacklist (Server Admin SDK Only) ────────
    match /bannedDevices/{deviceId} {
      allow read, write: if false; // Cloud Functions only
    }

    // ─── Decoy Honeypot Collections (Adversarial AI & Attacker Traps) ────
    match /adminDebugOverrides/{docId} {
      allow read, write: if false; // Honeypot trap: Any client access strictly denied
    }

    match /canteenDevBackdoor/{docId} {
      allow read, write: if false; // Honeypot trap: Any client access strictly denied
    }

    match /honeyTokens/{tokenId} {
      allow read, write: if false; // Honeypot trap: Any client access strictly denied
    }

    // ─── Default Deny ────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
