rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function currentStaffRoleIn(roles) {
      // Storage rules otherwise trust an old ID-token role forever. Bind every
      // administrative object operation to the server-owned staffUsers record
      // and require the token role to agree with it.
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/staffUsers/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/staffUsers/$(request.auth.uid)).data.role in roles
        && request.auth.token.role == firestore.get(/databases/(default)/documents/staffUsers/$(request.auth.uid)).data.role;
    }

    function hasAdministrativeAccess() {
      return currentStaffRoleIn(['admin', 'developer', 'manager', 'security_admin', 'system']);
    }

    function isManagerOrAdmin() {
      return hasAdministrativeAccess();
    }

    function validProofUpload() {
      return request.resource != null && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
    }

    function validMenuUpload() {
      return request.resource != null && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    // Faculty Verification ID Proofs (Private & Encrypted at Rest)
    match /verification_proofs/{userId}/{fileName} {
      // Explicitly test existing-resource absence as well: an upload must not
      // replace evidence already submitted for review, including new versions.
      // The Storage upload API also evaluates create for object replacement;
      // only an administrator may replace an already-existing proof.
      allow create: if validProofUpload() && (
        (resource == null && isOwner(userId)) || (resource != null && isManagerOrAdmin())
      );
      allow read: if isOwner(userId) || isManagerOrAdmin();
      allow update: if isManagerOrAdmin() && validProofUpload();
      allow delete: if isManagerOrAdmin();
    }

    // Public Menu Images (Admin Upload with Strict Size & MIME Whitelist)
    match /menu_images/{fileName} {
      allow read: if true;
      allow create, update: if isManagerOrAdmin() && validMenuUpload();
      allow delete: if isManagerOrAdmin();
    }

    match /menu_images/{menuItemId}/{fileName} {
      allow read: if true;
      allow create, update: if isManagerOrAdmin() && validMenuUpload();
      allow delete: if isManagerOrAdmin();
    }

    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
